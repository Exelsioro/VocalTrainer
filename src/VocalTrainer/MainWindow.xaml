                                    <CheckBox Content="Следить за исполнением" IsChecked="{Binding Melody.FollowPlayhead, Mode=TwoWay}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding Melody.DisplayedLoop}" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <Slider x:Name="MelodyTimeline" Minimum="0" Maximum="{Binding Melody.MaxViewStart}" Value="{Binding Melody.ViewStart, Mode=TwoWay}" SmallChange="1" LargeChange="10" Margin="0,8,0,0" ToolTip="Прокрути запись по времени; автослежение отключится"/>
                                <ProgressBar Margin="0,13,0,0" Maximum="100" Value="{Binding Melody.ProgressPercent, Mode=OneWay}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Melody.CurrentTarget, StringFormat=Эталон: {0}}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
