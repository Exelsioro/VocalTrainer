                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ПЕРЕНАЗНАЧЕНИЕ" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Hotkeys.Selected.Title, TargetNullValue='Выбери действие'}" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,10" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Hotkeys.CaptureMessage}" Foreground="#9BC8F8" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <Button Content="⌨ Изменить сочетание" Command="{Binding Hotkeys.CaptureCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Вернуть стандартные клавиши" Command="{Binding Hotkeys.DefaultsCommand}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding Hotkeys.Status}" Foreground="#9CCFAC" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                <TextBlock Text="Файл: %LOCALAPPDATA%\VocalTrainer\settings.json" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,20,0,0" FontSize="11"/>
                                <TextBlock Text="В текстовых полях одиночные клавиши и Space не перехватываются. Системные сочетания Windows не используются. Esc отменяет назначение." Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        <Border Grid.Row="2" Background="#0E1928" BorderBrush="#27374B" BorderThickness="0,1,0,0" Padding="27,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#9CB2CE" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="HEADPHONES RECOMMENDED    •    VOCAL TRAINER 0.5.1" Foreground="#7890AD" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
