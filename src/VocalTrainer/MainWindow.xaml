                        </StackPanel>
                    </Border></StackPanel><StackPanel x:Name="ExercisePracticeHost" Grid.Column="1"><Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VocalTrainer.Controls" Style="{StaticResource Panel}" Margin="0,0,0,15"><StackPanel>
<TextBlock Text="ТЮНЕР УПРАЖНЕНИЯ" Style="{StaticResource Caption}"/>
