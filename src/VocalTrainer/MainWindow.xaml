                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ПРОВЕРКА И СОХРАНЕНИЕ" Style="{StaticResource Caption}"/>
