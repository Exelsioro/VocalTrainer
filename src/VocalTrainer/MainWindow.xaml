                                        </Border>
                                        <TextBlock Text="{Binding EarTraining.ScoreText}" FontSize="16" Foreground="#8AE4C0" Margin="0,19,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
                                    <TextBlock Text="Изменяй интервал от 12 до 1 полутона по мере улучшения результатов. Этот тест проверяет восприятие высоты, а не умение петь." Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
