                                </Grid>
                                <TextBlock Text="{Binding Melody.CurrentVoice, StringFormat=Твой голос: {0}}" Margin="0,8,0,0" Foreground="#FFCA80" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}">
