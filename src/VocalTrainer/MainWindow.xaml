                                </WrapPanel>
                                <TextBlock Text="{Binding Melody.TrackWarning}" TextWrapping="Wrap" Foreground="#DFBC7B" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Melody.ReferenceSummary}" TextWrapping="Wrap" Foreground="#C6DDF5" Margin="0,10,0,0"/>
                                <Expander Header="Ноты, октавы и частоты эталона (выбранный фрагмент)" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0">
                                    <DataGrid x:Name="ReferenceNotesTable" ItemsSource="{Binding Melody.ReferencePitches}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="220" MinHeight="90">
