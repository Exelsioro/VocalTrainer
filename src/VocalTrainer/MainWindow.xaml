                                <ComboBox ItemsSource="{Binding Melody.Lyrics.Sources}" SelectedItem="{Binding Melody.Lyrics.SelectedSource, Mode=TwoWay}" DisplayMemberPath="Display" IsEnabled="{Binding Melody.Lyrics.CanEdit}"/>
                                <TextBlock Text="{Binding Melody.Lyrics.SourceName}" Foreground="{StaticResource Subtle}" Margin="0,8,0,8"/>
                                <DataGrid x:Name="SongLyricsTable" ItemsSource="{Binding Melody.Lyrics.Rows}" SelectedItem="{Binding Melody.Lyrics.SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" IsReadOnly="{Binding Melody.Lyrics.IsReadOnly}" MinHeight="130" MaxHeight="250">
