                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                                    <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="Управление без мыши" FontSize="25" FontWeight="Bold" Margin="0,7,0,8"/>
                                    <TextBlock Text="Выбери действие, нажми «Изменить», затем новое сочетание клавиш. Изменения сохраняются автоматически." TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Hotkeys.Rows}" SelectedItem="{Binding Hotkeys.Selected, Mode=TwoWay}" Background="#101C2B" BorderBrush="#324660" Foreground="#EAF2FF" MinHeight="370">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="7,7,7,7" MinWidth="480">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ScopeLabel}" Foreground="#93A6C2" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" Background="#233B55" CornerRadius="8" Padding="6,5">
