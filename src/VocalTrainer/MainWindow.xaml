<Window x:Class="VocalTrainer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VocalTrainer.Controls" Title="Vocal Trainer 0.5.1 · вокальная лаборатория" Width="1450" Height="900" MinWidth="1170" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0A111D" Foreground="#E9F1FF" FontFamily="Segoe UI" UseLayoutRounding="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#121E2E"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#17263A"/>
        <SolidColorBrush x:Key="Outline" Color="#283A52"/>
        <SolidColorBrush x:Key="Accent" Color="#9CC9FF"/>
        <SolidColorBrush x:Key="Subtle" Color="#91A4BF"/>
        <SolidColorBrush x:Key="Success" Color="#6EE5B1"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E9F1FF"/>
        <SolidColorBrush x:Key="TableSelection" Color="#31587B"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#283B55"/>
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1C2C40"/>
                                <Setter Property="Foreground" Value="#A1B2C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A2CCFF"/>
            <Setter Property="Foreground" Value="#112034"/>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#563845"/>
            <Setter Property="Foreground" Value="#FFD8DC"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#132037"/>
            <Setter Property="Background" Value="#EDF3FC"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF5FF"/>
            <Setter Property="Background" Value="#202F44"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="39"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#82DEB6"/>
            <Setter Property="Background" Value="#253B4B"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="TableTextEditor" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#0F2033"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#467BA6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#253A52"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A526E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#17263A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#203147"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#283F59"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableSelection}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableSelection}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="RowBackground" Value="#17263A"/>
            <Setter Property="AlternatingRowBackground" Value="#203147"/>
            <Setter Property="BorderBrush" Value="#31445E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D415A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#2D415A"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource {x:Type DataGridColumnHeader}}"/>
            <Setter Property="RowStyle" Value="{StaticResource {x:Type DataGridRow}}"/>
            <Setter Property="CellStyle" Value="{StaticResource {x:Type DataGridCell}}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TimelineCard" TargetType="Border">
            <Setter Property="Background" Value="#19283B"/>
            <Setter Property="BorderBrush" Value="#304058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Completed}" Value="True">
                    <Setter Property="Background" Value="#153B34"/>
                    <Setter Property="BorderBrush" Value="#296856"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="Background" Value="#234262"/>
                    <Setter Property="BorderBrush" Value="#9CC9FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0E1928" BorderBrush="#27374B" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#1B3C59" Margin="0,0,13,0">
                        <TextBlock Text="♫" FontSize="27" Foreground="#9ACFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VOCAL TRAINER" FontSize="18" FontWeight="Bold" Foreground="#F5F9FF"/>
                        <TextBlock Text="Студия интонации  /  Voice Lab" FontSize="12" Foreground="{StaticResource Subtle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#1B3039" CornerRadius="10" Padding="14,9">
                        <TextBlock Text="{Binding SessionStateText}" FontWeight="SemiBold" FontSize="11" Foreground="#80DFBE"/>
                    </Border>
                    <TextBlock Text="Локальный анализ · без облака" TextAlignment="Right" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="#0A111D" BorderThickness="0" Foreground="#DAE8FA" Padding="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,11"/>
                    <Setter Property="Background" Value="#17263A"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabFace" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#30445E" BorderThickness="0,0,1,1" CornerRadius="8,8,0,0">
                                    <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#B9CCE5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabFace" Property="Background" Value="#28405B"/>
                                        <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabFace" Property="Background" Value="#9CC9FF"/>
                                        <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#122034"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabFace" Property="BorderBrush" Value="#C6E1FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Тренажёр · тюнер">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <Grid Margin="22,23,22,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="302"/>
                </Grid.ColumnDefinitions>

                <!-- Left: setup and hardware -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="ЭТАЛОННАЯ НОТА" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Настройка звука" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,19"/>
                            <TextBlock Text="НОТА · ЛАТИНСКАЯ / РУССКАЯ" Style="{StaticResource Caption}"/>
                            <ComboBox Margin="0,7,0,17" ItemsSource="{Binding Notes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" IsEnabled="{Binding CanChangeNote}"/>
                            <TextBlock Text="ОКТАВА · НОМЕР И НАЗВАНИЕ" Style="{StaticResource Caption}"/>
                            <ComboBox x:Name="OctaveSelector" Margin="0,7,0,17" ItemsSource="{Binding Octaves}" DisplayMemberPath="Display" SelectedValuePath="Number" SelectedValue="{Binding SelectedOctave, Mode=TwoWay}" IsEnabled="{Binding CanChangeNote}"/>
                            <TextBlock Text="ДЛИТЕЛЬНОСТЬ ЭТАЛОНА · СЕК" Style="{StaticResource Caption}"/>
                            <TextBox Margin="0,7,0,13" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="▶  Воспроизвести ноту" Command="{Binding PlayToneCommand}"/>
                            <Button Content="■  Остановить звук" Command="{Binding StopToneCommand}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding RangeWarningText}" TextWrapping="Wrap" Foreground="#E7C27B" FontSize="11" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="МИКРОФОН / СЕССИЯ" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Захват голоса" FontWeight="SemiBold" FontSize="19" Margin="0,7,0,14"/>
                            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseMicrophone}"/>
                            <Button Content="{Binding SessionButtonText}" Command="{Binding ToggleSessionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,13,0,0"/>
                            <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" IsEnabled="{Binding CanRecord}" Margin="0,9,0,0"/>
                            <Button Content="◎  Калибровать шум (3 с)" Command="{Binding CalibrateCommand}" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding CalibrationText}" Foreground="#ADDCC8" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding RecordingStatusText}" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                            <TextBlock Text="WAV создаётся только по кнопке записи. В обычном режиме сохраняются числовые измерения." Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: live monitoring -->
                <StackPanel Grid.Column="1" Margin="0,0,15,0"><Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VocalTrainer.Controls" Style="{StaticResource Panel}" Margin="0,0,0,15"><StackPanel>
<CheckBox x:Name="FreeSingingToggle" Content="Свободное пение" IsChecked="{Binding FreeSingingEnabled, Mode=TwoWay}" IsEnabled="{Binding CanChangeSingingMode}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="Пой любые ноты: точность измеряется относительно ближайшей ноты, а не выбранного эталона." Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,10"/>
<Button Content="{Binding SessionButtonText}" Command="{Binding ToggleSessionCommand}"/>
<StackPanel Margin="0,12,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FreeSingingEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<TextBlock Text="{Binding FreeSinging.Note}" Foreground="#B8FFE1" FontSize="30" FontWeight="Bold"/>
<TextBlock Text="{Binding FreeSinging.Octave}" Foreground="{StaticResource Subtle}"/>
<TextBlock Text="{Binding FreeSinging.Intonation}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding FreeSinging.Movement}" Foreground="#FFCA80" FontSize="17" Margin="0,6,0,0"/>
<controls:PianoRoll x:Name="FreeSingingGraph" Voice="{Binding FreeSinging.Voice}" Duration="{Binding FreeSinging.Duration}" ViewStart="{Binding FreeSinging.ViewStart}" ViewWindowSeconds="30" PlayheadSeconds="{Binding FreeSinging.Cursor}" AccuracyToleranceCents="25" Height="210" Margin="0,10,0,10"/>
<TextBlock Text="{Binding FreeSinging.Summary}" TextWrapping="Wrap" Foreground="#B8D7F8"/>
<TextBlock Text="Частоты, ноты, отклонения, движение и тишина записываются в JSONL. WAV — только по отдельной кнопке записи." Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel></StackPanel></Border>
                    <Border Style="{StaticResource Panel}" Padding="25,22,25,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="VOICE PITCH · ТЮНЕР" Style="{StaticResource Caption}" Foreground="#8CCEFF"/>
                                    <TextBlock Text="Попадание в ноту" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B3443" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                                    <TextBlock Text="±25 ¢  ·  точная зона" Foreground="#80DDBC" FontSize="11"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,17,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunerReferenceLabel}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding TunerReferenceNote}" FontSize="60" FontWeight="Bold" Foreground="#E9F3FF" Margin="-3,0,0,-6"/>
                                    <TextBlock Text="{Binding TunerReferenceDescription}" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding TunerReferenceFrequency}" Foreground="#B0C6E6" Margin="0,10,0,0" FontSize="12"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="#2B4056" Margin="25,4"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                    <TextBlock Text="МИКРОФОН" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding DetectedNoteText}" FontSize="60" FontWeight="Bold" Foreground="#9DCFFF" Margin="-3,0,0,-6"/>
                                    <TextBlock Text="{Binding DetectedHzText}" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="#B0C6E6" Margin="0,10,0,0" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,7,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AccuracyText}" Foreground="{Binding AccuracyBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="1" Text="{Binding DeviationText}" Foreground="{Binding AccuracyBrush}" FontSize="31" FontWeight="Bold"/>
                            </Grid>
                            <controls:TunerGauge Grid.Row="3" Cents="{Binding TunerCents}" Height="82"/>
                            <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding FeedbackStatus}" Foreground="#ACBFD8" FontSize="11" Margin="0,68,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ГРАФИК ИНТОНАЦИИ" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding IntonationGraphTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <TextBlock Text="ПОСЛЕДНИЕ 30 С" Grid.Column="1" Foreground="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Bottom"/>
                            </Grid>
                            <controls:PitchGraph Points="{Binding HistoryPoints}" Height="182"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="−100 ¢" Foreground="{StaticResource Subtle}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="0 ¢ · ЦЕЛЬ" HorizontalAlignment="Center" Foreground="#77DCAF" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="+100 ¢" HorizontalAlignment="Right" Foreground="{StaticResource Subtle}" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    
                </StackPanel>

                <!-- Right: exercise and analytics -->
                <StackPanel Grid.Column="2">
                    
                    <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="ДАННЫЕ ЗАНЯТИЯ" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Журнал и заметки" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,12"/>
                            <TextBlock Text="{Binding LatestAssessmentText}" Foreground="#8AE4C0" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,11"/>
                            <TextBlock Text="{Binding SummaryText}" Foreground="#C7D7EC" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="ЗАМЕТКА К ЗАНЯТИЮ" Style="{StaticResource Caption}" Margin="0,17,0,5"/>
                            <TextBox Text="{Binding TrainingNote, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Добавить заметку" Command="{Binding SaveNoteCommand}" Margin="0,9,0,0"/>
                            <Button Content="↗  Открыть логи и записи" Command="{Binding OpenFolderCommand}" Margin="0,9,0,0"/>
                            <TextBlock Text="Логи: JSONL · только измерения, фазы, цели и события. Не содержат голоса." Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
            </TabItem><TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Упражнения">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25,23,25,28">
<TextBlock Text="УПРАЖНЕНИЯ · JSON" Style="{StaticResource Caption}"/>
<TextBlock Text="Библиотека и практика" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
<TextBlock Text="Выбери загруженное упражнение из списка или импортируй новое. Микрофон включается на вкладке «Тренажёр»." TextWrapping="Wrap" Foreground="{StaticResource Subtle}" Margin="0,0,0,18"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel x:Name="ExerciseControlsHost" Margin="0,0,16,0"><Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="УПРАЖНЕНИЕ JSON" Style="{StaticResource Caption}"/><ComboBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ExerciseSelector" Margin="0,12,0,6" ItemsSource="{Binding ExerciseChoices}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedExercise, Mode=TwoWay}" IsEnabled="{Binding CanChooseExercise}" ToolTip="{Binding SelectedExercise.SourcePath}"/>
                            <TextBlock Text="{Binding ExerciseTitle}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,9"/>
                            <TextBlock Text="ТИП УПРАЖНЕНИЯ" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="ExerciseModeSelector" ItemsSource="{Binding ExerciseModes}" DisplayMemberPath="Title" SelectedValuePath="Code" SelectedValue="{Binding ExerciseModeCode, Mode=TwoWay}" IsEnabled="{Binding CanChooseExercise}"/>
                            <CheckBox x:Name="ExerciseReferenceToggle" Content="Проиграть эталон" IsChecked="{Binding ExercisePlayReference, Mode=TwoWay}" IsEnabled="{Binding CanChooseExercise}" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
