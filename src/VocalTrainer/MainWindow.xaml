            <TabItem Header="Управление · F1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <Grid Margin="35,25,35,25" MaxWidth="1120" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
