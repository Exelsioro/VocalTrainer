                                    <Button Content="▶  Следующий вопрос" Style="{StaticResource PrimaryButton}" Command="{Binding EarTraining.NewChallengeCommand}"/>
                                    <Button Content="↻  Прослушать ещё раз" Margin="0,10,0,0" Command="{Binding EarTraining.ReplayCommand}"/>
