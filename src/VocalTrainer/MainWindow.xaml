                                </Grid>
                                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#18362F" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"><StackPanel>
<TextBlock x:Name="CurrentSongLine" Text="{Binding Melody.Lyrics.CurrentLine}" Foreground="#B8FFE1" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Melody.Lyrics.NextLine, StringFormat=Далее: {0}}" Foreground="#AFC8C1" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></Border><WrapPanel Margin="0,0,0,10">
                                    <TextBlock Text="■ Ноты MIDI" Foreground="#8CCBFA" Margin="0,0,20,0"/>
